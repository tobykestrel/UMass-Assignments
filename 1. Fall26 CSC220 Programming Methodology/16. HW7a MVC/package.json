{
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.13.0",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "archiver": "^5.3.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-tsc": "^0.5.0",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "canvas": "^3.2.3",
    "prettier": "^2.8.4",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "build": "tsc",
    "build:submission": "npm run format && npm run build && node ./zip.js",
    "format": "prettier --config .prettierrc --write src/",
    "format:check": "prettier --config .prettierrc --check src/",
    "lint": "eslint --config .eslintrc --max-warnings 0 src/",
    "lint:fix": "eslint --config .eslintrc --fix src/",
    "start": "node --no-warnings --loader ts-node/esm ./src/main.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage",
    "test:json": "npm test -- --json --outputFile=test-results.json",
    "bundle": "tsc --noEmit && esbuild ./src/*.ts ./src/**/*.ts --bundle --sourcemap --outdir=./dist && cp -r public/* dist",
    "serve": "serve dist"
  },
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "name": "07-mvc"
}
